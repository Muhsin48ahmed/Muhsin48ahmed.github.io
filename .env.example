# Absolute origin of the deployed site, used for link-preview (Open Graph) tags. No trailing slash.
VITE_SITE_URL=https://your-domain.example

# Formspree form ID for the contact form (https://formspree.io → New form → the id after /f/).
# Leave empty and the form falls back to opening the visitor's email app.
VITE_FORMSPREE_ID=
